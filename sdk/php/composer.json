{
    "name": "contextvault/contextvault-php",
    "description": "Official PHP SDK for ContextVault - versioned context storage for AI agents",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "ext-curl": "*",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.0",
        "symfony/polyfill-intl-normalizer": "^1.31",
        "symfony/polyfill-mbstring": "^1.31"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "ContextVault\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ContextVault\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": { "platform": { "php": "8.0.30" } }
}
