{
  "name": "@contextvault/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for ContextVault",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["contextvault", "sdk", "context", "workspace"],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/node": "^18.19.0"
  }
}
