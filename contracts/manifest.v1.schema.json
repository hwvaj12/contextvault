{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:contextvault:manifest:v1",
  "title": "Complete workspace manifest v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "description": "NFC relative path; canonical portable-name, ancestry, byte-limit, and collision validation is additionally required."
              },
              "kind": {
                "const": "file"
              },
              "byteLength": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "kind",
              "byteLength",
              "sha256"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "description": "NFC relative path; canonical portable-name, ancestry, byte-limit, and collision validation is additionally required."
              },
              "kind": {
                "const": "directory"
              }
            },
            "required": [
              "path",
              "kind"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "entries"
  ],
  "description": "UTF-8 JSON, sorted paths by unsigned UTF-8 bytes. Field order: schemaVersion, entries; file fields: path, kind, byteLength, sha256; directory fields: path, kind. No whitespace or trailing newline. SHA-256 hashes these exact bytes. Full snapshot omissions delete files. Structural schema does not replace canonical semantic validation."
}
