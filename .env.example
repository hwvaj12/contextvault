# Development listener. Container deployments can explicitly select HOST=0.0.0.0.
PORT=3000
HOST=127.0.0.1

# Generate a private administrator key before provisioning scoped API credentials.
# Never give the administrator key to an agent.
CONTEXTVAULT_API_KEY=

# Use an absolute private data directory in deployments.
# If unset, the service uses data under its working directory.
# CV_DATA_DIR=/absolute/private/contextvault
# CV_DATABASE_PATH=/absolute/private/contextvault/contextvault.db

# This default selects storage for new workspaces. Existing bindings require migration.
CV_STORAGE_BACKEND=git
# CV_GIT_ROOT=/absolute/private/contextvault/revisions/git
# CV_SUBMISSION_ROOT=/absolute/private/contextvault/submissions/git

# Only the local legacy-secrets provider is implemented in the service composition.
# Its default file is <CV_DATA_DIR>/secrets/tenant-keys.json.
CONTEXTVAULT_SECRETS_BACKEND=local
# CONTEXTVAULT_SECRETS_PATH=/absolute/private/contextvault/secrets/tenant-keys.json

# Optional S3 profile. Keep canonical storage credentials inside the service.
# AWS credentials use the standard AWS credential chain.
# CV_S3_PROVIDER=aws
# CV_S3_BUCKET=your-private-bucket
# CV_S3_REGION=us-east-1
# CV_S3_PREFIX=contextvault/
# CV_S3_KMS_KEY_ID=your-kms-key-id
# For an emulator, select localstack and set its explicit HTTP endpoint.
# CV_S3_ENDPOINT=http://127.0.0.1:4566

# Preserve old profiles through CV_STORAGE_PROFILES while accepted revisions need them.
# See docs/STORAGE_LAYER.md for profile configuration and migration.

CV_LEASE_TTL_MS=300000
CV_PROCESSING_TTL_MS=300000
CV_MAINTENANCE_INTERVAL_MS=1000
CV_REQUEST_TIMEOUT_MS=120000

# Bundle signing requires all three values.
# Encode an Ed25519 private key as base64 DER PKCS#8, not PEM.
# Encode its public key as base64 DER SPKI, not PEM.
# See docs/SECURITY_MODEL.md for signing formats and deployment requirements.
CONTEXTVAULT_SIGNING_PRIVATE_KEY=
CONTEXTVAULT_SIGNING_PUBLIC_KEY=
CONTEXTVAULT_SIGNING_KEY_ID=

# The catalog uses SQLite. This configuration does not enable SQLCipher.
