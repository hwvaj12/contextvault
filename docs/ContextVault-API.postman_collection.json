{
  "info": {
    "name": "ContextVault workspace lifecycle",
    "description": "Creates an isolated example workspace through authenticated v1 commands. Stop external writers before finalization. This collection retains its accepted example workspace for inspection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": ""
    },
    {
      "key": "apiKey",
      "value": ""
    },
    {
      "key": "customerId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "for(const key of ['baseUrl','apiKey','customerId']){if(!pm.environment.get(key)){throw new Error('Explicit '+key+' is required');}}",
          "pm.variables.set('commandKey',pm.variables.replaceIn('{{$guid}}'));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('expected status',()=>pm.response.to.have.status(200));",
              "pm.test('healthy service',()=>pm.expect(pm.response.json().status).to.eql('healthy'));"
            ]
          }
        }
      ]
    },
    {
      "name": "List workspaces",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": "{{baseUrl}}/v1/workspaces"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('expected status',()=>pm.response.to.have.status(200));",
              "pm.test('scoped workspace list',()=>pm.expect(pm.response.json().workspaces).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create workspace",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{commandKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/v1/workspaces",
        "body": {
          "mode": "raw",
          "raw": "{\"customerId\":\"{{customerId}}\",\"name\":\"Postman documentation lifecycle\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('expected status',()=>pm.expect(pm.response.code).to.be.oneOf([201,202]));",
              "const value=pm.response.json();pm.environment.set('workspaceId',pm.response.code===201?value.id:value.workspaceId);pm.environment.set('creationPolls',0);",
              "pm.test('durable workspace identity',()=>pm.expect(pm.environment.get('workspaceId')).to.be.a('string').and.not.empty);"
            ]
          }
        }
      ]
    },
    {
      "name": "Wait for creation",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": "{{baseUrl}}/v1/workspaces/{{workspaceId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('expected status',()=>pm.expect(pm.response.code).to.be.oneOf([200,404]));",
              "const count=Number(pm.environment.get('creationPolls')||0)+1;pm.environment.set('creationPolls',count);pm.test('bounded creation wait',()=>pm.expect(count).to.be.at.most(100));",
              "if(pm.response.code===404){pm.execution.setNextRequest('Wait for creation');setTimeout(()=>{},25);}else{pm.test('initial workspace version',()=>pm.expect(pm.response.json().version).to.eql(1));}"
            ]
          }
        }
      ]
    },
    {
      "name": "Open writer run",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{commandKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/v1/workspaces/{{workspaceId}}/runs",
        "body": {
          "mode": "raw",
          "raw": "{\"mode\":\"read-write\",\"agentLabel\":\"postman-documentation\",\"task\":\"Publish a complete snapshot\",\"reason\":\"Verify the documented API\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('expected status',()=>pm.response.to.have.status(201));",
              "const value=pm.response.json();pm.environment.set('runId',value.id);pm.environment.set('runVersion',value.version);pm.environment.set('leaseVersion',value.leaseVersion);",
              "pm.test('client-local protocol',()=>pm.expect(pm.response.json()).not.to.have.property('path'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Read pinned manifest",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": "{{baseUrl}}/v1/runs/{{runId}}/workspace/manifest"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('expected status',()=>pm.response.to.have.status(200));",
              "pm.test('empty initial snapshot',()=>pm.expect(pm.response.json()).to.eql({schemaVersion:1,entries:[]}));"
            ]
          }
        }
      ]
    },
    {
      "name": "Heartbeat",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{commandKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/v1/runs/{{runId}}/heartbeat",
        "body": {
          "mode": "raw",
          "raw": "{\"expectedLeaseVersion\":{{leaseVersion}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('expected status',()=>pm.response.to.have.status(200));",
              "const value=pm.response.json();pm.test('independent lease version',()=>{pm.expect(value.leaseVersion).to.eql(Number(pm.environment.get('leaseVersion'))+1);pm.expect(value.version).to.eql(Number(pm.environment.get('runVersion')));});pm.environment.set('leaseVersion',value.leaseVersion);"
            ]
          }
        }
      ]
    },
    {
      "name": "Begin submission",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{commandKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/v1/runs/{{runId}}/submissions",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('expected status',()=>pm.response.to.have.status(201));",
              "pm.environment.set('submissionId',pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Upload exact bytes",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{commandKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/octet-stream"
          },
          {
            "key": "X-Content-SHA256",
            "value": "bb207ba10d0bfc5cc437e161b08908e0ee276cd0dab7944fda79501c3ed8358a"
          }
        ],
        "url": "{{baseUrl}}/v1/runs/{{runId}}/submissions/{{submissionId}}/files?path=docs%2Foutput.txt",
        "body": {
          "mode": "raw",
          "raw": "ContextVault documentation\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('expected status',()=>pm.response.to.have.status(201));",
              "const value=pm.response.json();pm.environment.set('receiptId',value.id);pm.test('verified upload receipt',()=>{pm.expect(value.sha256).to.eql('bb207ba10d0bfc5cc437e161b08908e0ee276cd0dab7944fda79501c3ed8358a');pm.expect(value.byteLength).to.eql(27);});"
            ]
          }
        }
      ]
    },
    {
      "name": "Seal submission",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{commandKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/v1/runs/{{runId}}/submissions/{{submissionId}}/seal",
        "body": {
          "mode": "raw",
          "raw": "{\"manifest\":{\"schemaVersion\":1,\"entries\":[{\"path\":\"docs\",\"kind\":\"directory\"},{\"path\":\"docs/output.txt\",\"kind\":\"file\",\"byteLength\":27,\"sha256\":\"bb207ba10d0bfc5cc437e161b08908e0ee276cd0dab7944fda79501c3ed8358a\"},{\"path\":\"empty\",\"kind\":\"directory\"}]},\"receipts\":[{\"path\":\"docs/output.txt\",\"receiptId\":\"{{receiptId}}\"}]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('expected status',()=>pm.response.to.have.status(200));",
              "pm.test('immutable selection sealed',()=>pm.expect(pm.response.json().state).to.eql('sealed'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Finalize stopped writer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{commandKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/v1/runs/{{runId}}/finalize",
        "body": {
          "mode": "raw",
          "raw": "{\"expectedRunVersion\":{{runVersion}},\"submissionId\":\"{{submissionId}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('expected status',()=>pm.response.to.have.status(202));",
              "pm.environment.set('operationId',pm.response.json().id);pm.environment.set('finalizePolls',0);"
            ]
          }
        }
      ]
    },
    {
      "name": "Wait for finalization",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": "{{baseUrl}}/v1/operations/{{operationId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('expected status',()=>pm.response.to.have.status(200));",
              "const value=pm.response.json();pm.test('publication has no recorded failure',()=>pm.expect(value.state).to.be.oneOf(['pending','processing','succeeded']));",
              "const count=Number(pm.environment.get('finalizePolls')||0)+1;pm.environment.set('finalizePolls',count);pm.test('bounded finalization wait',()=>pm.expect(count).to.be.at.most(100));",
              "if(value.state!=='succeeded'){pm.execution.setNextRequest('Wait for finalization');setTimeout(()=>{},25);}else{pm.test('accepted finalization',()=>pm.expect(value.result.runState).to.eql('finalized'));}"
            ]
          }
        }
      ]
    },
    {
      "name": "Read accepted workspace",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": "{{baseUrl}}/v1/workspaces/{{workspaceId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('expected status',()=>pm.response.to.have.status(200));",
              "const value=pm.response.json();pm.environment.set('revisionId',value.currentRevisionId);pm.test('one accepted publication',()=>pm.expect(value.version).to.eql(2));"
            ]
          }
        }
      ]
    },
    {
      "name": "Read accepted manifest",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": "{{baseUrl}}/v1/workspaces/{{workspaceId}}/revisions/{{revisionId}}/manifest"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('expected status',()=>pm.response.to.have.status(200));",
              "pm.test('exact complete snapshot',()=>pm.expect(pm.response.json()).to.eql({\"schemaVersion\":1,\"entries\":[{\"path\":\"docs\",\"kind\":\"directory\"},{\"path\":\"docs/output.txt\",\"kind\":\"file\",\"byteLength\":27,\"sha256\":\"bb207ba10d0bfc5cc437e161b08908e0ee276cd0dab7944fda79501c3ed8358a\"},{\"path\":\"empty\",\"kind\":\"directory\"}]}));"
            ]
          }
        }
      ]
    },
    {
      "name": "Read accepted file",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": "{{baseUrl}}/v1/workspaces/{{workspaceId}}/revisions/{{revisionId}}/files?path=docs%2Foutput.txt"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('expected status',()=>pm.response.to.have.status(200));",
              "pm.test('exact stored bytes',()=>pm.expect(pm.response.text()).to.eql(\"ContextVault documentation\\n\"));",
              "pm.test('verified read digest',()=>pm.expect(pm.response.headers.get('X-Content-SHA256')).to.eql('bb207ba10d0bfc5cc437e161b08908e0ee276cd0dab7944fda79501c3ed8358a'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Open abort run",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{commandKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/v1/workspaces/{{workspaceId}}/runs",
        "body": {
          "mode": "raw",
          "raw": "{\"mode\":\"read-write\",\"agentLabel\":\"postman-documentation\",\"task\":\"Demonstrate abort isolation\",\"reason\":\"Verify the documented API\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('expected status',()=>pm.response.to.have.status(201));",
              "const value=pm.response.json();pm.environment.set('abortRunId',value.id);pm.environment.set('abortRunVersion',value.version);"
            ]
          }
        }
      ]
    },
    {
      "name": "Begin discarded submission",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{commandKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/v1/runs/{{abortRunId}}/submissions",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('expected status',()=>pm.response.to.have.status(201));",
              "pm.environment.set('discardSubmissionId',pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Upload discarded bytes",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{commandKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/octet-stream"
          },
          {
            "key": "X-Content-SHA256",
            "value": "1fcc4b37141c12bdbd26dde9b38274d3722510565931d89e3e43526c2ea68feb"
          }
        ],
        "url": "{{baseUrl}}/v1/runs/{{abortRunId}}/submissions/{{discardSubmissionId}}/files?path=discard.txt",
        "body": {
          "mode": "raw",
          "raw": "discarded",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('expected status',()=>pm.response.to.have.status(201));",
              "pm.test('staged bytes verified',()=>pm.expect(pm.response.json().sha256).to.eql('1fcc4b37141c12bdbd26dde9b38274d3722510565931d89e3e43526c2ea68feb'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Abort discarded run",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{commandKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/v1/runs/{{abortRunId}}/abort",
        "body": {
          "mode": "raw",
          "raw": "{\"expectedRunVersion\":{{abortRunVersion}},\"reason\":\"Discard documentation attempt\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('expected status',()=>pm.response.to.have.status(200));",
              "pm.test('explicit abort',()=>pm.expect(pm.response.json().state).to.eql('aborted'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Verify abort isolation",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": "{{baseUrl}}/v1/workspaces/{{workspaceId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('expected status',()=>pm.response.to.have.status(200));",
              "pm.test('abort preserves authoritative head',()=>{const value=pm.response.json();pm.expect(value.version).to.eql(2);pm.expect(value.currentRevisionId).to.eql(pm.environment.get('revisionId'));});"
            ]
          }
        }
      ]
    },
    {
      "name": "Read retained legacy metadata",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": "{{baseUrl}}/workspaces/{{workspaceId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('expected status',()=>pm.response.to.have.status(200));",
              "pm.test('compatibility resolves the same workspace',()=>pm.expect(pm.response.json().id).to.eql(pm.environment.get('workspaceId')));"
            ]
          }
        }
      ]
    }
  ]
}
