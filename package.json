{
  "name": "contextvault",
  "version": "1.0.0",
  "description": "**Multi-tenant, versioned workspace layer for AI agent memory.**",
  "main": "dist/index.js",
  "scripts": {
    "dev": "dotenv -e .env -- ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:tenants": "npx ts-node scripts/migrate-existing-tenants.ts",
    "test:contracts": "node scripts/run-workspace-tests.mjs contracts",
    "test:adapters": "node scripts/run-workspace-tests.mjs adapters",
    "test:acceptance": "node scripts/run-workspace-tests.mjs acceptance",
    "test:hosts": "node scripts/run-workspace-tests.mjs hosts",
    "test:sdk": "node scripts/run-workspace-tests.mjs sdk",
    "test:mcp": "node scripts/run-workspace-tests.mjs mcp",
    "test:legacy": "node scripts/run-workspace-tests.mjs legacy",
    "test:recovery": "node scripts/run-workspace-tests.mjs recovery",
    "test:migration": "node scripts/run-workspace-tests.mjs migration",
    "test:e2e": "node scripts/run-workspace-tests.mjs e2e",
    "test:docs": "node scripts/verify-workspace-docs.mjs",
    "verify:workspace-release": "node scripts/run-workspace-tests.mjs release"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lab-rat0212/contextvault.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/lab-rat0212/contextvault/issues"
  },
  "homepage": "https://github.com/lab-rat0212/contextvault#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/swagger": "9.9.3",
    "@fastify/swagger-ui": "6.1.3",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.3.1",
    "fastify": "5.12.8",
    "simple-git": "4.0.2",
    "ulid": "^3.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.0",
    "dotenv-cli": "^11.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.2",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@fastify/static": {
      ".": "10.1.3",
      "glob": "14.0.3"
    }
  }
}
