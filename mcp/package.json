{
  "name": "contextvault-mcp",
  "version": "0.1.0",
  "description": "Authenticated MCP access to ContextVault workspaces",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "contextvault-mcp": "bin/contextvault-mcp.mjs"
  },
  "files": [
    "dist",
    "bin",
    "vendor",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node bin/contextvault-mcp.mjs",
    "dev": "node src/index.mjs",
    "vendor:sdk": "node scripts/vendor-sdk.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "zod": "4.6.7",
    "@contextvault/sdk": "file:vendor/contextvault-sdk-0.1.0.tgz"
  },
  "devDependencies": {
    "@types/node": "18.19.130",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "bundledDependencies": [
    "@contextvault/sdk"
  ]
}
